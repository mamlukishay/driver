{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trempush",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GROUP", "class_name": "GroupDO" },
      // One per signed-in account (optional Google sign-in): profile, saved groups, session hashes.
      { "name": "USER", "class_name": "UserDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GroupDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UserDO"] }
  ],
  "observability": { "enabled": true },
  // Images (invites, car photos) go to R2. Remove this binding to fall back to storing
  // them inside each group's Durable Object; the worker picks at runtime, no code change.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "trempush-images" }],
  // Workers AI reads invitation images (free daily allowance). ANTHROPIC_API_KEY, if set, takes over.
  "ai": { "binding": "AI" },
  "vars": {
    // Vision model for invitation parsing. Alternative: "@cf/mistralai/mistral-small-3.1-24b-instruct"
    "INVITE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  }
  // Optional secrets (the app works without them; /api/config reports which are set):
  //   bunx wrangler secret put GOOGLE_MAPS_API_KEY   -> places autocomplete, geocoding, routes
  //   bunx wrangler secret put ANTHROPIC_API_KEY     -> invitation parsing with Claude instead of Workers AI
  //   bunx wrangler secret put GOOGLE_CLIENT_ID      -> optional Google sign-in (both needed;
  //   bunx wrangler secret put GOOGLE_CLIENT_SECRET     redirect URI <origin>/auth/google/callback)
  // Locally, put them in .dev.vars (gitignored). Never add AUTH_DEV_LOGIN here: it is a local-only
  // fake sign-in, enabled by vite.config.ts in `vite dev` (see worker/auth.ts).
}
